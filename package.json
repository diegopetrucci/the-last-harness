{
  "name": "the-last-harness",
  "version": "0.25.0",
  "description": "The Last Harness Pi package",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegopetrucci/the-last-harness.git"
  },
  "homepage": "https://github.com/diegopetrucci/the-last-harness#readme",
  "bugs": {
    "url": "https://github.com/diegopetrucci/the-last-harness/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check:package-versions": "node scripts/check-package-versions.mjs",
    "lint": "eslint \"scripts/**/*.{js,mjs,ts}\" \"tests/**/*.{js,mjs,ts}\" \"extensions/**/*.{js,mjs,ts}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=dot tests/*.test.mjs",
    "test:verbose": "node --test tests/*.test.mjs",
    "validate": "npm run check:package-versions && bash scripts/check-installer-smoke.sh && npm run typecheck && npm test && npm run lint && node scripts/merge-settings.mjs --dry-run && npm pack --dry-run"
  },
  "files": [
    "agents",
    "config",
    "extensions",
    "prompts",
    "scripts",
    "skills",
    "themes",
    "install.sh",
    "uninstall.sh",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.1 <=0.80.2",
    "@earendil-works/pi-tui": ">=0.80.1 <=0.80.2"
  },
  "dependencies": {
    "@tailwindcss/browser": "4.3.1",
    "glimpseui": "0.8.1",
    "monaco-editor": "0.55.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.2",
    "@earendil-works/pi-tui": "0.80.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26.0.0",
    "eslint": "10.5.0",
    "globals": "17.7.0",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0"
  }
}
