{
  "name": "the-last-harness",
  "version": "0.31.0",
  "description": "The Last Harness Pi package",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "agent",
    "developer-tools",
    "cli",
    "terminal",
    "typescript",
    "llm",
    "orchestration",
    "tlh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegopetrucci/the-last-harness.git"
  },
  "homepage": "https://github.com/diegopetrucci/the-last-harness#readme",
  "bugs": {
    "url": "https://github.com/diegopetrucci/the-last-harness/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build:runtime",
    "build:runtime": "node scripts/runtime-typescript.mjs build",
    "check:package-versions": "node scripts/check-package-versions.mjs",
    "check:runtime": "node scripts/runtime-typescript.mjs check",
    "check:startup-performance": "node scripts/check-startup-performance.mjs",
    "lint": "eslint \"scripts/**/*.{js,mjs,ts,mts}\" \"tests/**/*.{js,mjs,ts,mts}\" \"extensions/**/*.{js,mjs,ts,mts}\"",
    "lint:sh": "git ls-files '*.sh' | xargs shellcheck",
    "test": "node --test --test-reporter=dot \"tests/**/*.test.mjs\"",
    "test:verbose": "node --test \"tests/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "typecheck:runtime": "node scripts/runtime-typescript.mjs typecheck",
    "validate": "npm run check:package-versions && npm run typecheck && npm run typecheck:runtime && npm run check:runtime && bash scripts/check-installer-smoke.sh && npm test && npm run lint && npm run lint:sh && node scripts/merge-settings.mjs --dry-run && npm pack --dry-run"
  },
  "files": [
    "agents",
    "config",
    "extensions",
    "prompts",
    "scripts",
    "skills",
    "themes",
    "install.sh",
    "uninstall.sh",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./extensions/annotate-git-diff/index.js",
      "./extensions/the-last-harness.js"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1"
  },
  "dependencies": {
    "@tailwindcss/browser": "4.3.3",
    "glimpseui": "0.8.1",
    "monaco-editor": "0.56.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jiti": "2.7.0",
    "shellcheck": "4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
