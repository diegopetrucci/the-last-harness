        },
        {
          "path": "protocol/session-mirror/v1/CONFORMANCE.md",
          "sha256": "f157f2dda97e79308c19e015af323600d8f9d6b1a2bcea43c3d1b0fae79725e1"
        },
        {
          "path": "protocol/session-mirror/v1/manifest.json",
          "sha256": "8407d1ff18d3de13de6a9b78d49f86375d169c95e887ac6f334e3d73240b56ac"
        },
        {
          "path": "protocol/session-mirror/v1/conformance.ts",
          "sha256": "d6ebb1cc14d4dc5c12700ddf1d694b3fc8f8fbab7a3eb5bd9eabf8985aa62ec4"
        }
      ]
    }
  ],
