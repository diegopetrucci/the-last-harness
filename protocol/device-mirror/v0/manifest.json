{
  "manifestVersion": 1,
  "profile": {
    "family": "device-mirror",
    "major": 0,
    "minor": 1
  },
  "transport": {
    "framework": "Network.framework",
    "security": "TLS-PSK",
    "customCryptography": false,
    "plaintextFallback": false
  },
  "bounds": {
    "maxSessionMirrorEnvelopeBytes": 262144,
    "maxSnapshotFrameWrapperBytes": 839,
    "maxFrameBodyBytes": 262983,
    "maxControlFrameBytes": 16384,
    "maxListingEntries": 8,
    "maxInterfaceRecords": 256,
    "maxInterfaceAddresses": 64,
    "maxHandleCharacters": 128,
    "maxRequestIdCharacters": 64,
    "maxReplyTextBytes": 2048,
    "maxReplyRequestDigests": 8,
    "minReplyTtlSeconds": 1,
    "maxReplyTtlSeconds": 60,
    "maxCapabilities": 16,
    "maxRevision": 9007199254740990,
    "maxNormalizationDepth": 528,
    "maxNormalizationContainers": 12048,
    "maxNormalizationBytes": 1311559,
    "maxStateNormalizationContainers": 82048,
    "maxStateNormalizationBytes": 8651591
  },
  "requiredCapabilities": ["list", "subscribe", "snapshot-replace"],
  "optionalCapabilities": ["reply-text"],
  "replyReceiptCodes": [
    "accepted",
    "unconfirmed",
    "invalid",
    "unauthorized",
    "stale",
    "busy",
    "duplicate",
    "expired",
    "disconnected"
  ],
  "replyCloseReasons": [
    "producer-disconnect",
    "takeover",
    "listener-stop",
    "device-disconnect",
    "backgrounding",
    "authorization-withdrawn",
    "transport-failure"
  ],
  "replyOutcomeCodes": [
    "reply-pending",
    "reply-duplicate",
    "reply-busy",
    "reply-accepted",
    "reply-unconfirmed",
    "reply-invalid",
    "reply-unauthorized",
    "reply-stale",
    "reply-expired",
    "reply-disconnected"
  ],
  "listingStatuses": ["idle", "active", "waiting", "error", "unknown"],
  "listingFreshness": ["fresh", "stale", "unknown"],
  "dropReasons": [
    "producer-disconnect",
    "takeover",
    "accepted-event",
    "eviction",
    "listener-stop",
    "device-disconnect",
    "backgrounding"
  ],
  "closeReasons": ["listener-stop", "device-disconnect", "backgrounding", "transport-failure"],
  "directions": {
    "clientToListener": ["hello", "list", "subscribe", "reply"],
    "listenerToClient": [
      "ready",
      "list",
      "snapshot",
      "dropped",
      "close",
      "error",
      "receipt",
      "reply-close"
    ]
  },
  "wireErrorCodes": [
    "incompatible-protocol",
    "incompatible-capability",
    "malformed-frame",
    "frame-too-large",
    "control-frame-too-large",
    "snapshot-invalid",
    "snapshot-bounds",
    "snapshot-incompatible",
    "snapshot-forbidden",
    "snapshot-incomplete",
    "unknown-handle",
    "listener-stopped",
    "connection-busy",
    "device-disconnected",
    "reply-not-negotiated",
    "reply-not-pending"
  ],
  "frozenDependencies": [
    {
      "name": "session-mirror-v1",
      "path": "protocol/session-mirror/v1",
      "normativeFiles": [
        {
          "path": "protocol/session-mirror/v1/PROFILE.md",
